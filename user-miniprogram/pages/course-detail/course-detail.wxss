.page {
  min-height: 100vh;
  background: #F5F7F5;
  padding-bottom: 140rpx;
}

.page-loading {
  min-height: 100vh;
  background: #F5F7F5;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #999;
  font-size: 28rpx;
}

/* 头图 */
.hero {
  position: relative;
}

.hero-image {
  width: 100%;
  height: 400rpx;
  display: block;
}

.hero-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #1A5D3A 0%, #2E7D52 100%);
  color: rgba(255, 255, 255, 0.85);
  font-size: 48rpx;
  font-weight: bold;
  letter-spacing: 10rpx;
}

.hero-mask {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 32rpx 24rpx;
  background: linear-gradient(180deg, rgba(0, 0, 0, 0) 0%, rgba(0, 0, 0, 0.55) 100%);
}

.hero-title {
  font-size: 38rpx;
  font-weight: bold;
  color: #fff;
}

.hero-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
}

/* 卡片通用 */
.card {
  background: #fff;
  border-radius: 20rpx;
  margin: 24rpx;
  padding: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.card-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #1A1A1A;
  margin-bottom: 16rpx;
}

/* 教练卡 */
.coach-card {
  display: flex;
  align-items: center;
}

.coach-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.coach-avatar-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #1A5D3A;
  color: #fff;
  font-size: 40rpx;
  font-weight: bold;
}

.coach-info {
  margin-left: 20rpx;
  flex: 1;
  min-width: 0;
}

.coach-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #1A1A1A;
}

.coach-level {
  margin-left: 12rpx;
  font-size: 22rpx;
  color: #C9A962;
  font-weight: normal;
}

.coach-intro {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #666;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

/* 课程介绍 */
.desc {
  font-size: 26rpx;
  color: #444;
  line-height: 1.7;
  white-space: pre-wrap;
}

.meta-row {
  margin-top: 16rpx;
  display: flex;
  gap: 32rpx;
  font-size: 24rpx;
  color: #999;
}

/* 课次 */
.empty-sessions {
  padding: 48rpx 0;
  text-align: center;
  color: #999;
  font-size: 26rpx;
}

.session-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx;
  border: 2rpx solid #E8E8E8;
  border-radius: 16rpx;
  margin-bottom: 16rpx;
}

.session-selected {
  border-color: #1A5D3A;
  background: rgba(26, 93, 58, 0.06);
}

.session-disabled {
  opacity: 0.5;
}

.session-date {
  font-size: 28rpx;
  font-weight: bold;
  color: #1A1A1A;
}

.session-time {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #666;
}

.remaining {
  font-size: 24rpx;
  color: #1A5D3A;
  font-weight: 600;
}

.unavailable {
  font-size: 24rpx;
  color: #999;
}

/* 底部操作栏 */
.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #fff;
  padding: 20rpx 24rpx calc(20rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -4rpx 12rpx rgba(0, 0, 0, 0.06);
}

.bar-price-value {
  font-size: 44rpx;
  font-weight: bold;
  color: #E6A23C;
}

.bar-price-unit {
  font-size: 24rpx;
  color: #999;
  margin-left: 6rpx;
}

.bar-btn {
  background: linear-gradient(135deg, #1A5D3A 0%, #2E7D52 100%);
  color: #fff;
  font-size: 30rpx;
  font-weight: bold;
  padding: 22rpx 80rpx;
  border-radius: 44rpx;
}

.bar-btn-disabled {
  opacity: 0.5;
}

/* 支付弹层 */
.pay-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 100;
  display: flex;
  align-items: flex-end;
}

.pay-modal {
  width: 100%;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 32rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
}

.pay-title {
  font-size: 32rpx;
  font-weight: bold;
  text-align: center;
  margin-bottom: 24rpx;
}

.pay-session {
  background: #F5F7F5;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 20rpx;
}

.pay-course-name {
  font-size: 28rpx;
  font-weight: bold;
  color: #1A1A1A;
}

.pay-session-time {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #666;
}

.pay-amount {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 24rpx;
}

.pay-amount-value {
  font-size: 36rpx;
  font-weight: bold;
  color: #E6A23C;
}

.pay-type {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx;
  border: 2rpx solid #E8E8E8;
  border-radius: 16rpx;
  margin-bottom: 16rpx;
  font-size: 28rpx;
}

.pay-type-active {
  border-color: #1A5D3A;
  background: rgba(26, 93, 58, 0.05);
}

.pay-type-left {
  display: flex;
  align-items: center;
}

.pay-type-icon {
  margin-right: 12rpx;
  font-size: 32rpx;
}

.pay-type-right {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.balance {
  font-size: 24rpx;
  color: #999;
}

.balance-low {
  color: #F56C6C;
}

.radio {
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  border: 2rpx solid #CCC;
}

.radio-on {
  border-color: #1A5D3A;
  background: #1A5D3A;
  box-shadow: inset 0 0 0 6rpx #fff;
}

.pay-btns {
  display: flex;
  gap: 20rpx;
  margin-top: 32rpx;
}

.pay-cancel {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  border-radius: 44rpx;
  background: #F0F0F0;
  color: #666;
  font-size: 28rpx;
}

.pay-confirm {
  flex: 2;
  text-align: center;
  padding: 24rpx 0;
  border-radius: 44rpx;
  background: linear-gradient(135deg, #1A5D3A 0%, #2E7D52 100%);
  color: #fff;
  font-size: 28rpx;
  font-weight: bold;
}

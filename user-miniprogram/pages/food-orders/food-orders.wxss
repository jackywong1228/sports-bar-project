.page {
  min-height: 100vh;
  background: #F5F7F5;
}

/* 状态 Tab（对齐 course-bookings 样式） */
.tabs {
  display: flex;
  background: #fff;
  padding: 0 12rpx;
  position: sticky;
  top: 0;
  z-index: 10;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 28rpx 0 24rpx;
  font-size: 26rpx;
  color: #666;
  position: relative;
  white-space: nowrap;
}

.tab-active {
  color: #1A5D3A;
  font-weight: bold;
}

.tab-active::after {
  content: '';
  position: absolute;
  bottom: 8rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 48rpx;
  height: 6rpx;
  border-radius: 3rpx;
  background: #1A5D3A;
}

.order-list {
  padding: 24rpx;
}

.order-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.06);
}

.order-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.order-no {
  font-size: 26rpx;
  color: #666;
  font-weight: 600;
}

.order-status {
  font-size: 26rpx;
  font-weight: bold;
}

.order-type {
  margin-top: 12rpx;
  font-size: 28rpx;
  color: #1A1A1A;
  font-weight: bold;
}

.order-summary {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #999;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.order-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #F0F0F0;
}

.order-time {
  font-size: 22rpx;
  color: #999;
}

.order-amount-box {
  display: flex;
  align-items: baseline;
}

.order-qty {
  font-size: 22rpx;
  color: #999;
  margin-right: 12rpx;
}

.order-amount {
  font-size: 32rpx;
  font-weight: bold;
  color: #E6A23C;
}

/* 空态 / 加载态 */
.empty-box {
  padding: 120rpx 0;
  text-align: center;
}

.empty-icon {
  font-size: 80rpx;
}

.empty-text {
  margin-top: 24rpx;
  font-size: 30rpx;
  color: #666;
}

.empty-action {
  margin: 32rpx auto 0;
  width: 240rpx;
  background: #1A5D3A;
  color: #fff;
  font-size: 28rpx;
  border-radius: 40rpx;
  padding: 16rpx 0;
}

.loading-box {
  padding: 80rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: #999;
}

<view class="page">
  <view wx:if="{{loading && !order}}" class="loading-box">加载中...</view>

  <block wx:elif="{{order}}">
    <!-- 状态头 -->
    <view class="status-card">
      <view class="status-main" style="color: {{order.status_color}};">{{order.status_text_display}}</view>
      <view class="status-sub">{{order.type_line}}</view>
      <view class="status-no" bindtap="copyOrderNo">订单号 {{order.order_no}}（点击复制）</view>
    </view>

    <!-- 状态时间线 -->
    <view class="card">
      <view class="card-title">订单进度</view>
      <view class="timeline">
        <view class="timeline-item" wx:for="{{timeline}}" wx:key="label">
          <view class="timeline-dot {{item.active ? 'timeline-dot-active' : ''}}"></view>
          <view class="timeline-content">
            <text class="timeline-label {{item.active ? 'timeline-label-active' : ''}}">{{item.label}}</text>
            <text class="timeline-time" wx:if="{{item.time}}">{{item.time}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 商品明细 -->
    <view class="card">
      <view class="card-title">商品明细</view>
      <view class="goods-line" wx:for="{{order.items}}" wx:key="id">
        <image wx:if="{{item.food_image}}" class="goods-img" src="{{item.food_image}}" mode="aspectFill" />
        <view wx:else class="goods-img goods-img-placeholder">🍴</view>
        <view class="goods-info">
          <view class="goods-name">{{item.food_name}}</view>
          <view class="goods-specs" wx:if="{{item.specs_text}}">{{item.specs_text}}</view>
        </view>
        <view class="goods-right">
          <text class="goods-price">¥{{item.subtotal_text}}</text>
          <text class="goods-qty">¥{{item.price_text}} x{{item.quantity}}</text>
        </view>
      </view>
      <view class="remark-line" wx:if="{{order.remark}}">备注：{{order.remark}}</view>
    </view>

    <!-- 金额明细 -->
    <view class="card">
      <view class="amount-row">
        <text class="amount-label">商品总额</text>
        <text class="amount-value">¥{{order.total_amount_text}}</text>
      </view>
      <view class="amount-row" wx:if="{{order.discount_amount > 0}}">
        <text class="amount-label">优惠券抵扣</text>
        <text class="amount-value amount-discount">-¥{{order.discount_text}}</text>
      </view>
      <view class="amount-row amount-pay-row">
        <text class="amount-label">实付金额</text>
        <text class="amount-pay">¥{{order.pay_amount_text}}</text>
      </view>
    </view>

    <!-- 支付信息 -->
    <view class="card">
      <view class="card-title">支付信息</view>
      <view class="info-row">
        <text class="info-label">支付方式</text>
        <text class="info-value">{{order.pay_type_text}}</text>
      </view>
      <view class="info-row" wx:if="{{order.pay_time}}">
        <text class="info-label">支付时间</text>
        <text class="info-value">{{order.pay_time}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">下单时间</text>
        <text class="info-value">{{order.created_at}}</text>
      </view>
      <view class="info-row" wx:if="{{order.status === 'cancelled' && order.refund_amount > 0}}">
        <text class="info-label">退款金额</text>
        <text class="info-value refund-value">¥{{order.refund_amount_text}}</text>
      </view>
      <view class="info-row" wx:if="{{order.status === 'cancelled' && order.refund_time}}">
        <text class="info-label">退款时间</text>
        <text class="info-value">{{order.refund_time}}</text>
      </view>
      <view class="info-row" wx:if="{{order.status === 'cancelled' && order.refund_reason}}">
        <text class="info-label">退款原因</text>
        <text class="info-value">{{order.refund_reason}}</text>
      </view>
    </view>

    <!-- 继续支付 -->
    <view class="repay-wrap" wx:if="{{order.can_pay}}">
      <view class="repay-tip">订单 15 分钟内未支付将自动关闭</view>
      <view class="repay-btn {{paying ? 'repay-btn-disabled' : ''}}" bindtap="handleRepay">
        {{paying ? '支付中...' : '继续支付'}}
      </view>
    </view>

    <view class="bottom-space"></view>

    <!-- 底部固定退款提示（会员端不提供取消/退款按钮） -->
    <view class="refund-bar">{{order.refund_tip || '如需退款请联系店员'}}</view>
  </block>

  <!-- 加载失败空态 -->
  <view wx:if="{{!loading && !order}}" class="empty-box">
    <view class="empty-icon">📄</view>
    <view class="empty-text">订单不存在或已删除</view>
  </view>
</view>

.page {
  min-height: 100vh;
  background: #F5F7F5;
  padding: 24rpx 24rpx 0;
  box-sizing: border-box;
}

/* 状态头 */
.status-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 40rpx 24rpx;
  margin-bottom: 24rpx;
  text-align: center;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.06);
}

.status-main {
  font-size: 40rpx;
  font-weight: bold;
}

.status-sub {
  margin-top: 16rpx;
  font-size: 28rpx;
  color: #333;
}

.status-no {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #999;
}

.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.06);
}

.card-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #1A1A1A;
  margin-bottom: 20rpx;
}

/* 时间线 */
.timeline {
  padding-left: 8rpx;
}

.timeline-item {
  display: flex;
  align-items: flex-start;
  position: relative;
  padding-bottom: 28rpx;
}

.timeline-item:last-child {
  padding-bottom: 0;
}

.timeline-item:not(:last-child)::before {
  content: '';
  position: absolute;
  left: 11rpx;
  top: 28rpx;
  bottom: 0;
  width: 2rpx;
  background: #E8EBE8;
}

.timeline-dot {
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  background: #E0E0E0;
  flex-shrink: 0;
  margin-top: 4rpx;
}

.timeline-dot-active {
  background: #1A5D3A;
}

.timeline-content {
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
}

.timeline-label {
  font-size: 28rpx;
  color: #999;
}

.timeline-label-active {
  color: #1A1A1A;
  font-weight: 600;
}

.timeline-time {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #999;
}

/* 商品明细 */
.goods-line {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #F7F7F7;
}

.goods-line:last-of-type {
  border-bottom: none;
}

.goods-img {
  width: 96rpx;
  height: 96rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
}

.goods-img-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #F0F2F0;
  font-size: 40rpx;
}

.goods-info {
  flex: 1;
  margin-left: 20rpx;
  min-width: 0;
}

.goods-name {
  font-size: 28rpx;
  color: #1A1A1A;
}

.goods-specs {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #999;
}

.goods-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.goods-price {
  font-size: 28rpx;
  font-weight: bold;
  color: #1A1A1A;
}

.goods-qty {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #999;
}

.remark-line {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #666;
}

/* 金额明细 */
.amount-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 0;
}

.amount-label {
  font-size: 26rpx;
  color: #666;
}

.amount-value {
  font-size: 28rpx;
  color: #1A1A1A;
}

.amount-discount {
  color: #E6A23C;
}

.amount-pay-row {
  border-top: 1rpx solid #F0F0F0;
  margin-top: 8rpx;
  padding-top: 20rpx;
}

.amount-pay {
  font-size: 36rpx;
  font-weight: bold;
  color: #E6A23C;
}

/* 支付信息 */
.info-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 10rpx 0;
}

.info-label {
  font-size: 26rpx;
  color: #666;
}

.info-value {
  font-size: 26rpx;
  color: #1A1A1A;
}

.refund-value {
  color: #F56C6C;
  font-weight: bold;
}

/* 继续支付 */
.repay-wrap {
  margin-bottom: 24rpx;
}

.repay-tip {
  text-align: center;
  font-size: 22rpx;
  color: #999;
  margin-bottom: 16rpx;
}

.repay-btn {
  background: #1A5D3A;
  color: #fff;
  text-align: center;
  font-size: 30rpx;
  font-weight: bold;
  border-radius: 40rpx;
  padding: 22rpx 0;
}

.repay-btn-disabled {
  background: #C7CCC8;
}

.bottom-space {
  height: 140rpx;
}

/* 底部固定退款提示 */
.refund-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #FFF8EC;
  color: #B88230;
  font-size: 24rpx;
  text-align: center;
  padding: 20rpx 24rpx calc(20rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.06);
  z-index: 80;
}

/* 空态 / 加载态 */
.empty-box {
  padding: 120rpx 0;
  text-align: center;
}

.empty-icon {
  font-size: 80rpx;
}

.empty-text {
  margin-top: 24rpx;
  font-size: 30rpx;
  color: #666;
}

.loading-box {
  padding: 80rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: #999;
}

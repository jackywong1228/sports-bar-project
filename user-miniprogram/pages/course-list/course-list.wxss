.page {
  min-height: 100vh;
  background: #F5F7F5;
}

/* 分类 Tab */
.tabs {
  display: flex;
  background: #fff;
  padding: 0 12rpx;
  position: sticky;
  top: 0;
  z-index: 10;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 28rpx 0 24rpx;
  font-size: 28rpx;
  color: #666;
  position: relative;
}

.tab-active {
  color: #1A5D3A;
  font-weight: bold;
}

.tab-active::after {
  content: '';
  position: absolute;
  bottom: 8rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 48rpx;
  height: 6rpx;
  border-radius: 3rpx;
  background: #1A5D3A;
}

/* 课程卡片 */
.course-list {
  padding: 24rpx;
}

.course-card {
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.06);
}

.course-cover {
  width: 100%;
  height: 280rpx;
  display: block;
}

.course-cover-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #1A5D3A 0%, #2E7D52 100%);
  color: rgba(255, 255, 255, 0.85);
  font-size: 40rpx;
  font-weight: bold;
  letter-spacing: 8rpx;
}

.course-body {
  padding: 24rpx;
}

.course-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #1A1A1A;
}

.course-subtitle {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #999;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.coach-row {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
}

.coach-avatar {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
}

.coach-avatar-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #1A5D3A;
  color: #fff;
  font-size: 24rpx;
}

.coach-name {
  margin-left: 12rpx;
  font-size: 26rpx;
  color: #333;
}

.coach-level {
  margin-left: 8rpx;
  font-size: 22rpx;
  color: #C9A962;
}

.course-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 20rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #F0F0F0;
}

.time-info {
  display: flex;
  align-items: center;
}

.time-icon {
  font-size: 24rpx;
  margin-right: 6rpx;
}

.time-text {
  font-size: 24rpx;
  color: #1A5D3A;
  font-weight: 600;
}

.session-count {
  font-size: 22rpx;
  color: #999;
  margin-left: 6rpx;
}

.price {
  font-size: 34rpx;
  font-weight: bold;
  color: #E6A23C;
}

.price-unit {
  font-size: 22rpx;
  font-weight: normal;
  margin-left: 4rpx;
}

/* 空态 / 加载态 */
.empty-box {
  padding: 120rpx 0;
  text-align: center;
}

.empty-icon {
  font-size: 80rpx;
}

.empty-text {
  margin-top: 24rpx;
  font-size: 30rpx;
  color: #666;
}

.empty-sub {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #999;
}

.loading-box {
  padding: 80rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: #999;
}
